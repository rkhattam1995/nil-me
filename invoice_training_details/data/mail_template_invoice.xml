<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_nil_invoice_sending" model="mail.template">
            <field name="name">NIL Invoice: Sending</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="email_from">{{ (object.invoice_user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="use_default_to" eval="True"/>
            <field name="subject">{{ object.company_id.name }} - Invoice {{ object.name or '' }}</field>
            <field name="description">Legacy NIL invoice email template</field>
            <field name="body_html" type="html"><div><p>Legacy template.</p></div></field>
            <field name="report_template_ids" eval="[]"/>
        </record>

        <record id="mail_template_nil_invoice_sending_v2" model="mail.template">
            <field name="name">NIL Invoice: Sending (Current)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="email_from">{{ (object.invoice_user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="subject">Invoice {{ object.name or '' }} - {{ object.company_id.name or '' }}</field>
            <field name="description">Current NIL invoice email used automatically by Send &amp; Print</field>
            <field name="body_html" type="html">
<div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#333333;line-height:1.5;">
    <p style="margin:0 0 14px 0;">Dear <span t-out="object.partner_id.name or 'Customer'"></span>,</p>
    <p style="margin:0 0 16px 0;">Please find attached our invoice for your reference.</p>
    <div style="font-size:17px;font-weight:bold;margin:0 0 10px 0;"><span t-out="object.company_id.name or ''"></span></div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 0 18px 0;">
        <tr>
            <td style="padding:4px 24px 4px 0;font-weight:bold;">Invoice Number:</td>
            <td style="padding:4px 0;"><span t-out="object.name or ''"></span></td>
        </tr>
        <tr>
            <td style="padding:4px 24px 4px 0;font-weight:bold;">Invoice Date:</td>
            <td style="padding:4px 0;"><span t-out="format_date(object.invoice_date) if object.invoice_date else ''"></span></td>
        </tr>
        <tr>
            <td style="padding:4px 24px 4px 0;font-weight:bold;">Due Date:</td>
            <td style="padding:4px 0;"><span t-out="format_date(object.invoice_date_due) if object.invoice_date_due else ''"></span></td>
        </tr>
        <tr>
            <td style="padding:4px 24px 4px 0;font-weight:bold;">Invoice Amount:</td>
            <td style="padding:4px 0;font-weight:bold;"><span t-out="format_amount(object.amount_total, object.currency_id) or ''"></span></td>
        </tr>
    </table>
    <p style="margin:0 0 10px 0;">Kindly arrange payment in accordance with the agreed payment terms.</p>
    <p style="margin:0 0 18px 0;">Should you require any clarification regarding this invoice, please feel free to contact us.</p>
    <p style="margin:0;">Sincerely,<br/><strong>Finance Department</strong><br/><span t-out="object.company_id.name or ''"></span></p>
</div>
            </field>
            <field name="report_template_ids" eval="[]"/>
        </record>
    </data>
</odoo>
