<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_po_document_layout_finishing"
              inherit_id="invoice_training_details.report_po_document_training">

        <!-- HEADER -->
        <xpath expr="//div[hasclass('row', 'pt-3', 'pb-3')]" position="replace">

            <div class="row pt-3 pb-3 po-header-meta"
                 style="font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:1.35;">

                <div class="col-8" style="padding-left:0;">

                    <div style="margin-bottom:5px;">
                        <strong>Company Name:</strong>

                        <span t-if="o.partner_id.is_company"
                              t-field="o.partner_id.name"/>

                        <span t-if="not o.partner_id.is_company"
                              t-field="o.partner_id.parent_id.name"/>
                    </div>


                    <div style="margin-bottom:5px;">
                        <strong>Company Address:</strong>

                        <span t-if="o.partner_id.street"
                              t-field="o.partner_id.street"/>

                        <t t-if="o.partner_id.street2">
                            <t t-if="o.partner_id.street">, </t>
                            <span t-field="o.partner_id.street2"/>
                        </t>

                        <t t-if="o.partner_id.city">
                            <t t-if="o.partner_id.street or o.partner_id.street2">, </t>
                            <span t-field="o.partner_id.city"/>
                        </t>

                        <t t-if="o.partner_id.country_id">
                            <t t-if="o.partner_id.street or o.partner_id.street2 or o.partner_id.city">, </t>
                            <span t-field="o.partner_id.country_id.name"/>
                        </t>

                    </div>


                    <div t-if="(o.partner_id.is_company and o.partner_id.vat) or (not o.partner_id.is_company and o.partner_id.parent_id.vat)"
                         style="margin-bottom:5px;">

                        <strong>Tax Number:</strong>

                        <span t-if="o.partner_id.is_company"
                              t-field="o.partner_id.vat"/>

                        <span t-if="not o.partner_id.is_company"
                              t-field="o.partner_id.parent_id.vat"/>

                    </div>


                    <div t-if="not o.partner_id.is_company">

                        <strong>Attention:</strong>

                        <span t-field="o.partner_id.name"/>

                    </div>

                </div>


                <div class="col-4"
                     style="padding-right:0;text-align:right;">

                    <div style="
                        margin-left:auto;
                        margin-right:0;
                        text-align:right;
                        white-space:nowrap;
                    ">

                        <div style="margin-bottom:5px;">

                            <strong>

                                <span t-if="is_clc_order">
                                    Work Order:
                                </span>

                                <span t-if="not is_clc_order">
                                    Purchase Order:
                                </span>

                            </strong>

                            <span>&#160;</span>

                            <span t-if="is_clc_order"
                                  t-esc="o.name.replace('PO-', 'WO-', 1) if o.name.startswith('PO-') else 'WO-' + o.name"/>

                            <span t-if="not is_clc_order"
                                  t-field="o.name"/>

                        </div>


                        <div style="margin-bottom:5px;">

                            <strong>Date:</strong>

                            <span>&#160;</span>

                            <span t-field="o.date_order"
                                  t-options="{&quot;widget&quot;:&quot;date&quot;,&quot;format&quot;:&quot;dd/MM/yyyy&quot;}"/>

                        </div>


                        <div t-if="o.validity_date">

                            <strong>Validity Date:</strong>

                            <span>&#160;</span>

                            <span t-field="o.validity_date"
                                  t-options="{&quot;widget&quot;:&quot;date&quot;,&quot;format&quot;:&quot;dd/MM/yyyy&quot;}"/>

                        </div>

                    </div>

                </div>

            </div>

        </xpath>


        <!-- CHANGE STUDENTS TO SEATS -->
        <xpath expr="//table[@name='training_line_table']//span[normalize-space()='# Of Students']"
               position="replace">

            <span t-if="not is_cisco_u_all_access">Seats</span>

        </xpath>


        <!-- TRAINING TABLE STYLE -->
        <xpath expr="//table[@name='training_line_table']"
               position="before">

            <style>

                .po-header-meta,
                .po-header-meta *,
                .po-invoice-total-box,
                .po-invoice-total-box *,
                .po-terms-content,
                .po-terms-content *,
                .po-bank-details,
                .po-bank-details * {
                    font-family: Arial, Helvetica, sans-serif !important;
                    font-size: 18px !important;
                    line-height: 1.35 !important;
                }


                table[name="training_line_table"],
                table[name="training_line_table"] * {
                    font-family: Arial, Helvetica, sans-serif !important;
                    line-height: 1.35 !important;
                }


                /* TRAINING TABLE HEADERS */
                table[name="training_line_table"] thead th,
                table[name="training_line_table"] thead th * {
                    font-size: 18px !important;
                }


                /* TRAINING TABLE VALUES: balanced, readable PDF cells. */
                table[name="training_line_table"] {
                    width: 100% !important;
                    table-layout: auto !important;
                    border-collapse: collapse !important;
                }

                table[name="training_line_table"] tbody td,
                table[name="training_line_table"] tbody td * {
                    font-size: 16px !important;
                    line-height: 1.45 !important;
                }

                table[name="training_line_table"] tbody td {
                    padding: 8px 6px !important;
                    text-align: center !important;
                    vertical-align: middle !important;
                    word-break: normal !important;
                }

                table[name="training_line_table"] tbody td.po-training-name {
                    white-space: normal !important;
                    padding-left: 10px !important;
                    padding-right: 10px !important;
                }

                /* Keep the currency sign and full amount on the same line. */
                table[name="training_line_table"] tbody td.po-training-money,
                table[name="training_line_table"] tbody td.po-training-money * {
                    white-space: nowrap !important;
                }

                table[name="training_line_table"] tbody td.po-training-compact,
                table[name="training_line_table"] tbody td.po-training-compact * {
                    white-space: nowrap !important;
                }

                /* Allow a date range to wrap, but never split a single date. */
                table[name="training_line_table"] tbody td.po-training-dates span {
                    white-space: nowrap !important;
                }

                .po-invoice-total-box tr.o_total td,
                .po-invoice-total-box tr.o_total td *,
                .po-invoice-total-box tr.o_total strong,
                .po-invoice-total-box tr.o_total span {
                    font-weight: 700 !important;
                }

            </style>

        </xpath>


        <!-- Classes only: preserve every existing WO/PO table column and value. -->
        <xpath expr="//table[@name='training_line_table']//tbody//td[span[@t-field='training.training_id']]"
               position="attributes">
            <attribute name="class" add="po-training-name" separator=" "/>
        </xpath>

        <xpath expr="//table[@name='training_line_table']//tbody//td[span[@t-field='training.no_of_student']]"
               position="attributes">
            <attribute name="class" add="po-training-compact" separator=" "/>
        </xpath>

        <xpath expr="//table[@name='training_line_table']//tbody//td[span[@t-field='training.duration']]"
               position="attributes">
            <attribute name="class" add="po-training-compact" separator=" "/>
        </xpath>

        <xpath expr="//table[@name='training_line_table']//tbody//td[span[@t-field='training.training_date_start']]"
               position="attributes">
            <attribute name="class" add="po-training-dates" separator=" "/>
        </xpath>

        <xpath expr="//table[@name='training_line_table']//tbody//td[@t-att-rowspan='total_rows']"
               position="attributes">
            <attribute name="class" add="po-training-money" separator=" "/>
        </xpath>


        <!-- TERMS -->
        <xpath expr="//div[@t-field='o.term_and_cond']"
               position="attributes">

            <attribute name="class">
                po-terms-content
            </attribute>

            <attribute name="style">
                width:100%;
                font-family:Arial,Helvetica,sans-serif;
                font-size:18px;
                line-height:1.35;
            </attribute>

        </xpath>


        <!-- BANK DETAILS -->
        <xpath expr="//span[@t-field='o.bank_details']/ancestor::p[1]"
               position="attributes">

            <attribute name="class">
                po-bank-details
            </attribute>

            <attribute name="style">
                font-family:Arial,Helvetica,sans-serif;
                font-size:18px;
                line-height:1.35;
            </attribute>

        </xpath>


        <!-- BIGGER STAMP -->
        <xpath expr="//img[@t-if='o.company_id.stamp and o.display_stamp']"
               position="attributes">

            <attribute name="style">
                max-height:160px;
                max-width:190px;
                width:auto;
                height:auto;
                object-fit:contain;
                vertical-align:bottom;
                display:inline-block;
            </attribute>

        </xpath>

    </template>

</odoo>
