<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="crm_training_customer_discount_fields" model="ir.ui.view">
        <field name="name">crm.lead.training.customer.discount.fields</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="invoice_training_details.crm_reveal_lead_opportunity_form_training"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='training']//field[@name='training_course_ids']/tree/field[@name='price']" position="after">
                <field name="nil_customer_discount_type" string="Discount Type"/>
                <field name="nil_customer_discount_value" string="Discount Value" readonly="not nil_customer_discount_type"/>
                <field name="nil_customer_discount_amount" string="Discount Amount" readonly="1"/>
                <field name="nil_customer_net_price" string="Final Training Price" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="sale_training_customer_discount_fields" model="ir.ui.view">
        <field name="name">sale.order.training.customer.discount.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="invoice_training_details.sale_order_form_quote_training"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='training']//field[@name='training_course_ids']/tree/field[@name='price']" position="after">
                <field name="nil_customer_discount_type" string="Discount Type"/>
                <field name="nil_customer_discount_value" string="Discount Value" readonly="not nil_customer_discount_type"/>
                <field name="nil_customer_discount_amount" string="Discount Amount" readonly="1"/>
                <field name="nil_customer_net_price" string="Final Training Price" readonly="1"/>
            </xpath>
            <xpath expr="//page[@id='training']//field[@name='total_training_price']" position="after">
                <field name="nil_customer_training_discount_amount" readonly="1"/>
                <field name="nil_customer_training_net_total" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
