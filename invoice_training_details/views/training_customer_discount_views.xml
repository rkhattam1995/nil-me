<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Reuse old view IDs so module upgrade removes training-tab discount fields. -->
    <record id="crm_training_customer_discount_fields" model="ir.ui.view">
        <field name="name">crm.lead.training.customer.discount.fields</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="invoice_training_details.crm_reveal_lead_opportunity_form_training"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='training']//field[@name='training_course_ids']" position="attributes">
                <attribute name="string">Training Courses</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_training_customer_discount_fields" model="ir.ui.view">
        <field name="name">sale.order.training.customer.discount.fields</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="invoice_training_details.sale_order_form_quote_training"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='training']//field[@name='training_course_ids']" position="attributes">
                <attribute name="string">Training Courses</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_customer_discount_fields" model="ir.ui.view">
        <field name="name">sale.order.form.order.lines.customer.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                <field name="nil_discount_type" string="Discount Type" optional="show"/>
                <field name="nil_discount_value" string="Discount Value" optional="show" readonly="not nil_discount_type"/>
                <field name="nil_line_discount_amount" string="Discount Amount" optional="show" readonly="1"/>
                <field name="nil_discount_managed" column_invisible="1"/>
                <field name="nil_original_discount_percent" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
