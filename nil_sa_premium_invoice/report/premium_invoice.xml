<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_premium_invoice" model="report.paperformat">
        <field name="name">NIL Saudi Premium A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">11</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">0</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>
    <record id="action_premium_invoice" model="ir.actions.report">
        <field name="name">Saudi Premium Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nil_sa_premium_invoice.premium_invoice</field>
        <field name="report_file">nil_sa_premium_invoice.premium_invoice</field>
        <field name="paperformat_id" ref="paperformat_premium_invoice"/>
        <field name="print_report_name">object._get_report_base_filename()</field>
        <field name="attachment_use" eval="False"/>
    </record>

    <template id="party">
        <div class="party-title" dir="rtl"><strong t-out="party_ar"/></div>
        <div class="party-name" dir="auto" t-out="p.name"/>
        <div class="address" dir="rtl">
            <span t-if="p.street" t-field="p.street"/><br t-if="p.street"/>
            <span t-if="p.street2" t-field="p.street2"/><br t-if="p.street2"/>
            <div t-if="p.l10n_sa_edi_building_number"><strong class="party-label">رقم المبنى:</strong> <bdi class="party-value" dir="ltr" t-field="p.l10n_sa_edi_building_number"/></div>
            <span t-if="p.city" t-field="p.city"/> <span t-if="p.state_id" t-field="p.state_id.name"/> <span t-if="p.zip" t-field="p.zip"/>
            <div t-if="p.l10n_sa_edi_plot_identification"><strong class="party-label">الرقم الإضافي:</strong> <span class="party-value" dir="ltr" t-field="p.l10n_sa_edi_plot_identification"/></div>
            <br t-if="p.country_id"/><span t-if="p.country_id" t-field="p.country_id.name"/>
        </div>
        <div t-if="p.vat" class="id-line" dir="rtl"><strong class="party-label">الرقم الضريبي:</strong> <bdi class="party-value" dir="ltr" t-field="p.vat"/></div>
        <div t-if="p.l10n_sa_additional_identification_number and p.l10n_sa_additional_identification_scheme == 'CRN'" class="id-line" dir="rtl"><strong class="party-label">السجل التجاري:</strong> <bdi class="party-value" dir="ltr" t-field="p.l10n_sa_additional_identification_number"/></div>
        <div t-elif="p.l10n_sa_additional_identification_number and p.l10n_sa_additional_identification_scheme" class="id-line" dir="rtl"><strong class="party-label"><span t-out="{'TIN': 'الرقم الضريبي', 'MOM': 'رخصة البلدية', 'MLS': 'رخصة وزارة الموارد البشرية', '700': 'الرقم الموحد 700', 'SAG': 'رخصة الاستثمار', 'NAT': 'رقم الهوية الوطنية', 'GCC': 'هوية مجلس التعاون الخليجي', 'IQA': 'رقم الإقامة', 'PAS': 'رقم جواز السفر', 'OTH': 'رقم تعريف آخر'}.get(p.l10n_sa_additional_identification_scheme, 'رقم التعريف')"/>:</strong> <bdi class="party-value" dir="ltr" t-field="p.l10n_sa_additional_identification_number"/></div>
    </template>

    <template id="premium_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="nil_sa_premium_invoice.premium_document" t-lang="'en_US'"/>
            </t>
        </t>
    </template>
    <template id="premium_document">
        <t t-set="o" t-value="doc.with_context(lang='en_US')"/>
        <t t-set="o_ar" t-value="doc.with_context(lang='ar_001')"/>
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="seller" t-value="company.partner_id.with_context(lang='ar_001')"/>
        <t t-set="buyer" t-value="o.partner_id.with_context(lang='ar_001')"/>
        <div class="article nil-sa-premium" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" data-oe-lang="en_US">
            <style>
                @font-face {font-family:'NIL Tajawal';src:url('/web/static/fonts/google/Tajawal/Tajawal-Regular.ttf') format('truetype');font-style:normal;font-weight:400;}
                @font-face {font-family:'NIL Tajawal';src:url('/web/static/fonts/google/Tajawal/Tajawal-Bold.ttf') format('truetype');font-style:normal;font-weight:700;}
                .nil-sa-premium, .nil-sa-premium * {box-sizing:border-box;font-family:Calibri,Carlito,'NIL Tajawal',sans-serif !important;}
                .nil-sa-premium {font-size:10pt;color:#253038;line-height:1.25;}
                .nil-sa-premium .ar, .nil-sa-premium .ar *, .nil-sa-premium .party, .nil-sa-premium .party * {font-family:'NIL Tajawal',Calibri,Carlito,sans-serif !important;}
                .nil-sa-premium .en, .nil-sa-premium .en *, .nil-sa-premium .num, .nil-sa-premium .num *, .nil-sa-premium bdi {font-family:Calibri,Carlito,'NIL Tajawal',sans-serif !important;}
                .nil-sa-premium .en {font-size:9pt;color:#59636b;font-weight:400;display:block;direction:ltr;line-height:1.25;margin-top:2px;}
                .nil-sa-premium .page > table,.nil-sa-premium .totals {width:100%;table-layout:fixed;border-collapse:collapse;border:0 !important;}
                .nil-sa-premium .page > table > tbody > tr > td,.nil-sa-premium .page > table > thead > tr > th,.nil-sa-premium .totals > tbody > tr > td {border:0 !important;}
                .nil-sa-premium .top {margin-bottom:7px;}
                .nil-sa-premium table.top,.nil-sa-premium table.title,
                .nil-sa-premium table.top > tbody,.nil-sa-premium table.title > tbody,
                .nil-sa-premium table.top > tr,.nil-sa-premium table.title > tr,
                .nil-sa-premium table.top > tbody > tr,.nil-sa-premium table.title > tbody > tr,
                .nil-sa-premium table.top > tr > td,.nil-sa-premium table.title > tr > td,
                .nil-sa-premium table.top > tbody > tr > td,.nil-sa-premium table.title > tbody > tr > td {border:0 none transparent !important;outline:0 none !important;box-shadow:none !important;background:transparent !important;}
                .nil-sa-premium .top td {padding-bottom:5px;vertical-align:middle;}
                .nil-sa-premium .title {margin-bottom:8px;}
                .nil-sa-premium .title td {vertical-align:middle;}
                .nil-sa-premium .title .en {font-size:11pt;}
                .nil-sa-premium .party {background:#f3f4f5;border-top:2px solid #253038 !important;padding:8px 10px;vertical-align:top;width:49%;text-align:right;}
                .nil-sa-premium .party-title {border-bottom:1px solid #cfd4d7;padding-bottom:4px;margin-bottom:5px;font-size:10pt;}
                .nil-sa-premium .party-name {font-size:10pt;font-weight:700;margin-bottom:3px;}
                .nil-sa-premium .address {margin-bottom:4px;font-size:9.5pt;line-height:1.25;}
                .nil-sa-premium .id-line {margin-top:3px;font-size:9.5pt;}
                .nil-sa-premium .id-line bdi {display:inline-block;direction:ltr;font-weight:400 !important;}
                .nil-sa-premium .party .party-label {font-weight:700 !important;}
                .nil-sa-premium .party .party-value,.nil-sa-premium .party .party-value * {font-weight:400 !important;}
                .nil-sa-premium .meta {margin:7px 0 7px;}
                .nil-sa-premium .meta td {width:50%;padding:4px 5px;vertical-align:middle;text-align:center !important;border:1px solid #d7dbde !important;}
                .nil-sa-premium .meta strong {display:inline;font-size:9.5pt;line-height:1.3;}
                .nil-sa-premium .meta .en {display:inline-block;text-align:center !important;font-size:8.5pt;margin:0 3px;white-space:nowrap;}
                .nil-sa-premium .meta .num {display:inline-block;margin:0 3px;font-size:9.5pt;white-space:nowrap;}
                .nil-sa-premium .lines {direction:rtl;margin:0 0 6px;table-layout:fixed !important;}
                .nil-sa-premium .lines thead {display:table-header-group;}
                .nil-sa-premium .lines th {background:#253038;color:white;font-weight:700;padding:4px 3px;text-align:center !important;vertical-align:middle !important;font-size:9.5pt;line-height:1.25;border:1px solid #253038 !important;}
                .nil-sa-premium .lines th .ar {display:block;min-height:2.35em;}
                .nil-sa-premium .lines th .en {color:#e6e9eb;font-size:8.5pt;text-align:center !important;margin-top:1px;}
                .nil-sa-premium .lines td {padding:5px 3px;border:1px solid #d7dbde !important;vertical-align:middle;text-align:center;font-size:9.5pt;line-height:1.35;}
                .nil-sa-premium .lines tbody tr:nth-child(even) {background:#f3f4f5;}
                .nil-sa-premium .lines tr {page-break-inside:avoid;}
                .nil-sa-premium .lines .desc {text-align:right;word-wrap:break-word;padding:5px 6px;}
                .nil-sa-premium .lines .desc .en {font-size:9pt;line-height:1.25;margin-top:2px;}
                .nil-sa-premium .num {direction:ltr;unicode-bidi:embed;white-space:nowrap;}
                .nil-sa-premium .totals td {padding:5px 6px;border-bottom:1px solid #e1e4e6 !important;font-size:10pt;vertical-align:middle;}
                .nil-sa-premium .totals td:first-child {text-align:right !important;}
                .nil-sa-premium .totals td:first-child .ar {display:block;direction:rtl;text-align:right !important;}
                .nil-sa-premium .totals td:first-child .en {display:block;direction:ltr;text-align:right !important;margin:2px 0 0;}
                .nil-sa-premium .grand td {background:#253038;color:white;font-size:11pt;}
                .nil-sa-premium .grand .en {color:#e6e9eb;}
                .nil-sa-premium .closing {page-break-inside:avoid;margin-top:5px;}
                .nil-sa-premium table.nil-sa-qr-layout,.nil-sa-premium table.nil-sa-qr-layout > tbody,.nil-sa-premium table.nil-sa-qr-layout > tr,.nil-sa-premium table.nil-sa-qr-layout > tbody > tr,.nil-sa-premium table.nil-sa-qr-layout > tr > td,.nil-sa-premium table.nil-sa-qr-layout > tbody > tr > td,.nil-sa-premium .nil-sa-qr-cell,.nil-sa-premium .nil-sa-qr-cell img {border:0 none transparent !important;outline:0 none !important;box-shadow:none !important;}
                .nil-sa-premium .nil-sa-qr-cell {background:transparent !important;}
                .nil-sa-premium .fine {font-size:9pt;color:#59636b;}
                .nil-sa-premium .training-extra {margin:5px 0 0;font-size:9pt;line-height:1.25;word-wrap:break-word;}
                .nil-sa-premium .training-extra p {margin:0 0 3px;line-height:1.25;}
                .nil-sa-premium .training-extra ul,.nil-sa-premium .training-extra ol {margin-top:2px;margin-bottom:3px;}
                .nil-sa-premium .training-extra li {margin-top:0;margin-bottom:1px;}
                .nil-sa-premium .training-extra h1,.nil-sa-premium .training-extra h2,.nil-sa-premium .training-extra h3,.nil-sa-premium .training-extra h4,.nil-sa-premium .training-extra h5,.nil-sa-premium .training-extra h6 {font-size:10pt;line-height:1.25;margin:3px 0;page-break-after:avoid;}
                .nil-sa-premium .training-extra table {max-width:100%;border-collapse:collapse;}
                .nil-sa-premium .training-extra tr {page-break-inside:avoid;}
            </style>
            <div class="page" style="margin: 0; padding: 0; min-height: 0;">
                <table class="top" dir="ltr" style="border:0 none transparent !important;outline:0 none !important;box-shadow:none !important;"><tr>
                    <td style="width:72%; text-align:left;"><strong t-field="company.name"/><div class="en">NIL Middle East</div></td>
                    <td style="text-align:right;"><img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-width:35mm; max-height:17mm;" alt="Company logo"/></td>
                </tr></table>
                <table class="title" dir="rtl" style="border:0 none transparent !important;outline:0 none !important;box-shadow:none !important;"><tr>
                    <td style="text-align:right; width:60%;">
                        <strong class="ar" style="font-size:17pt;" t-if="o.move_type == 'out_refund'">إشعار دائن</strong>
                        <strong class="ar" style="font-size:17pt;" t-elif="o._l10n_sa_is_simplified()">فاتورة ضريبية مبسطة</strong>
                        <strong class="ar" style="font-size:17pt;" t-else="">فاتورة ضريبية</strong>
                        <div class="en" style="font-size:11pt;" t-if="o.move_type == 'out_refund'">CREDIT NOTE</div>
                        <div class="en" style="font-size:11pt;" t-elif="o._l10n_sa_is_simplified()">SIMPLIFIED TAX INVOICE</div>
                        <div class="en" style="font-size:11pt;" t-else="">TAX INVOICE</div>
                    </td>
                    <td style="text-align:left;"><strong style="font-size:13pt;" class="num" t-field="o.name"/></td>
                </tr></table>
                <table dir="rtl"><tr>
                    <td class="party">
                        <t t-call="nil_sa_premium_invoice.party"><t t-set="p" t-value="buyer"/><t t-set="party_ar" t-value="'المشتري'"/></t>
                        <div t-if="buyer != buyer.commercial_partner_id" class="fine" dir="auto" t-field="buyer.commercial_partner_id.name"/>
                    </td>
                    <td style="width:2%;"/>
                    <td class="party"><t t-call="nil_sa_premium_invoice.party"><t t-set="p" t-value="seller"/><t t-set="party_ar" t-value="'البائع'"/></t></td>
                </tr></table>
                <div t-if="o.partner_shipping_id and o.partner_shipping_id != o.partner_id" groups="account.group_delivery_invoice_address" dir="rtl" class="fine" style="margin-top:6px;">
                    عنوان الشحن / Shipping Address: <span t-field="o.partner_shipping_id" t-options='{"widget":"contact","fields":["address","name"],"no_marker":True}'/>
                </div>
                <table class="meta" dir="rtl"><colgroup><col style="width:50%"/><col style="width:50%"/></colgroup><tr>
                    <td><strong class="ar">تاريخ الفاتورة:</strong><span class="en" dir="ltr">Invoice Date</span><span class="num" dir="ltr" t-out="o.invoice_date.isoformat() if o.invoice_date else ''"/></td>
                    <td><strong class="ar">تاريخ الاستحقاق:</strong><span class="en" dir="ltr">Due Date</span><span class="num" dir="ltr" t-out="o.invoice_date_due.isoformat() if o.invoice_date_due else ''"/></td>
                </tr><tr t-if="o.delivery_date and o.delivery_date != o.invoice_date"><td colspan="2"><strong class="ar">تاريخ التوريد:</strong><span class="en" dir="ltr">Supply Date</span><span class="num" dir="ltr" t-out="o.delivery_date.isoformat()"/></td></tr></table>
                <div dir="rtl" class="fine" t-if="o.ref or o.partner_id.ref or o.reversed_entry_id">
                    <span t-if="o.ref">المرجع / Reference: <bdi t-field="o.ref"/></span>
                    <span t-if="o.partner_id.ref"> | رمز العميل / Customer Code: <bdi t-field="o.partner_id.ref"/></span>
                    <span t-if="o.reversed_entry_id"> | الفاتورة الأصلية / Original invoice: <bdi t-field="o.reversed_entry_id.name"/></span>
                </div>
                <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                <table class="lines" dir="rtl" name="invoice_line_table">
                    <colgroup><col t-att-style="'width:27%' if display_discount else 'width:34%'"/><col style="width:7%"/><col style="width:14%"/><col t-if="display_discount" style="width:7%"/><col style="width:12%"/><col style="width:9%"/><col style="width:12%"/><col style="width:12%"/></colgroup>
                    <thead><tr>
                        <th><span class="ar">البند / الوصف</span><div class="en">Item / Description</div></th>
                        <th><span class="ar">الكمية</span><div class="en">Qty</div></th><th><span class="ar">سعر الوحدة</span><div class="en">Unit price</div></th>
                        <th t-if="display_discount"><span class="ar">الخصم %</span><div class="en">Disc. %</div></th>
                        <th><span class="ar">قبل الضريبة</span><div class="en">Excl. VAT</div></th><th><span class="ar">نسبة الضريبة</span><div class="en">VAT rate</div></th>
                        <th><span class="ar">قيمة الضريبة</span><div class="en">VAT amount</div></th><th><span class="ar">شامل الضريبة</span><div class="en">Incl. VAT</div></th>
                    </tr></thead>
                    <tbody>
                        <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
                        <t t-set="section" t-value="False"/><t t-set="section_total" t-value="0"/>
                        <t t-foreach="lines" t-as="line">
                            <tr t-if="line.display_type in ('line_section', 'line_note')"><td colspan="99" class="desc" t-att-style="'font-weight:bold;' if line.display_type == 'line_section' else ''"><span t-field="line.name" t-options="{'widget':'text'}"/></td></tr>
                            <t t-if="line.display_type == 'line_section'"><t t-set="section" t-value="True"/><t t-set="section_total" t-value="0"/></t>
                            <tr t-if="line.display_type not in ('line_section', 'line_note')">
                                <td class="desc">
                                    <t t-if="line.product_id"><strong class="ar" dir="rtl" t-out="line.product_id.with_context(lang='ar_001').name"/></t>
                                    <div dir="ltr" class="en" style="text-align:right; white-space:pre-wrap;" t-field="line.name"/>
                                </td>
                                <td><span class="num" t-field="line.quantity"/></td>
                                <td><span class="num" t-field="line.price_unit" t-options="{'widget':'monetary','display_currency': o.currency_id}"/></td>
                                <td t-if="display_discount"><span class="num" t-field="line.discount"/></td>
                                <td><span class="num" t-field="line.price_subtotal" t-options="{'widget':'float','precision': o.currency_id.decimal_places}"/></td>
                                <td><span t-out="', '.join((tax.invoice_label or tax.name) for tax in line.tax_ids)"/></td>
                                <td><span class="num" t-field="line.l10n_gcc_invoice_tax_amount" t-options="{'widget':'float','precision': o.currency_id.decimal_places}"/></td>
                                <td><strong class="num" t-field="line.price_total" t-options="{'widget':'float','precision': o.currency_id.decimal_places}"/></td>
                            </tr>
                            <t t-set="section_total" t-value="section_total + line.price_subtotal"/>
                            <tr t-if="section and (line_last or lines[line_index+1].display_type == 'line_section')"><td colspan="99" class="desc">الإجمالي الفرعي / Subtotal: <span class="num" t-out="section_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr>
                        </t>
                    </tbody>
                </table>
                <table class="closing nil-sa-qr-layout" dir="rtl"><tr>
                    <td style="width:61%; vertical-align:top;">
                        <table class="totals" dir="rtl"><colgroup><col style="width:60%"/><col style="width:40%"/></colgroup>
                            <tr><td><span class="ar">المبلغ الخاضع للضريبة غير شامل الضريبة</span><div class="en">Invoice taxable amount (excl. VAT)</div></td><td style="text-align:left;"><span class="num" t-field="o.amount_untaxed"/></td></tr>
                            <t t-set="tax_totals" t-value="o.tax_totals or {}"/>
                            <t t-foreach="tax_totals.get('subtotals', [])" t-as="subtotal">
                                <t t-foreach="tax_totals['groups_by_subtotal'][subtotal['name']]" t-as="group">
                                    <tr><td><span class="ar">ضريبة القيمة المضافة</span><div class="en" t-out="group['tax_group_name']"/><div t-if="tax_totals.get('display_tax_base')" class="fine" t-out="group['formatted_tax_group_base_amount']"/></td><td style="text-align:left;"><span class="num" t-out="group['formatted_tax_group_amount']"/></td></tr>
                                </t>
                            </t>
                            <tr class="grand"><td><span class="ar">إجمالي الفاتورة شامل الضريبة</span><div class="en">Invoice total (incl. VAT)</div></td><td style="text-align:left;"><strong class="num" t-field="o.amount_total"/></td></tr>
                        </table>
                    </td>
                    <td class="nil-sa-qr-cell" style="width:39%; text-align:center; vertical-align:top; border:0 none transparent !important; outline:0 none !important; box-shadow:none !important;">
                        <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('QR', quote_plus(o.l10n_sa_qr_code_str), 300, 300)" style="width:40mm; height:40mm; border:0 none transparent !important; outline:0 none !important; box-shadow:none !important;" alt="ZATCA QR"/>
                    </td>
                </tr></table>
                <div t-if="o.currency_id != company.currency_id" dir="rtl" class="closing">
                    <t t-set="rate_date" t-value="o.invoice_date"/>
                    <table class="totals"><tr><td>سعر الصرف / Exchange Rate</td><td class="num" t-out="o.env['res.currency']._get_conversion_rate(o.currency_id, company.currency_id, company, rate_date)" t-options="{'widget':'float','precision':5}"/></tr>
                    <tr><td>الإجمالي الفرعي بالريال السعودي / Subtotal</td><td class="num" t-out="abs(o.amount_untaxed_signed)" t-options="{'widget':'monetary','display_currency':o.company_currency_id}"/></tr>
                    <tr><td>ضريبة القيمة المضافة بالريال السعودي / VAT Amount</td><td class="num" t-out="o.currency_id._convert(o.amount_tax, company.currency_id, company, rate_date)" t-options="{'widget':'monetary','display_currency':o.company_currency_id}"/></tr>
                    <tr><td>الإجمالي بالريال السعودي / Total</td><td class="num" t-out="abs(o.amount_total_signed)" t-options="{'widget':'monetary','display_currency':o.company_currency_id}"/></tr></table>
                </div>
                <div t-if="company.display_invoice_amount_total_words" dir="rtl" class="fine"><div t-out="o._num2words(o.amount_total, 'ar_001')"/><div class="en" t-field="o.amount_total_words"/></div>
                <div t-if="o.narration" dir="auto" class="fine" t-field="o.narration"/>
                <!-- Existing invoice Training tab fields; keep the same order as the KSA custom report. -->
                <div t-if="not nil_is_html_empty(o.term_and_cond)" class="training-extra" dir="auto" t-field="o.term_and_cond"/>
                <div t-if="not nil_is_html_empty(o.bank_details)" class="training-extra" dir="auto" t-field="o.bank_details"/>
 
            </div>
        </div>
