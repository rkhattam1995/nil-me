<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_premium_invoice" model="ir.ui.view">
        <field name="name">account.move.form.nil.sa.premium.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_nil_sa_premium_invoice" type="object" string="Saudi Premium Invoice"
                        invisible="country_code != 'SA' or state != 'posted' or move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
